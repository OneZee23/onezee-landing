# Copy to `.env` next to docker-compose.yml and fill in. NEVER commit the real .env.
#   openssl rand -base64 24   → a strong DB password
#   openssl rand -base64 40   → APP_SECRET (signs sessions)
UMAMI_DB_PASSWORD=change-me-strong-db-password
UMAMI_APP_SECRET=change-me-long-random-secret

# Cloudflare Tunnel token for umami.onezee.dev (Zero Trust → Tunnels → create
# "umami-onezee" → copy the token after --token). See README.md.
UMAMI_TUNNEL_TOKEN=paste-cloudflare-tunnel-token
