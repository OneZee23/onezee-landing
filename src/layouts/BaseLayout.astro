---
import BaseHead from '../components/BaseHead.astro';
// Global styles (the original landing stylesheet — reused verbatim).
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  lang?: 'ru' | 'en';
  alternates?: { hreflang: string; href: string }[];
  noindex?: boolean;
  theme?: 'glass'; // opt a page into the light Liquid-Glass palette (homepage only)
}

const { lang = 'en', theme } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {...Astro.props} />
    {/* Opt the glass homepage into native cross-document view transitions so the
        EN/RU pill glides across the language switch. Scoped to the homepage. */}
    {theme === 'glass' && <style is:inline set:html="@view-transition { navigation: auto; }" />}
  </head>
  <body class={theme === 'glass' ? 'theme-glass' : undefined}>
    <slot />

    {/* Scroll-reveal as a tiny, framework-independent enhancement.
        Guarantees content becomes visible even if the observer never fires. */}
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!els.length) return;
        var show = function (el) { el.classList.add('is-visible'); };
        var showAll = function () { els.forEach(show); };
        if (!('IntersectionObserver' in window)) { showAll(); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { show(e.target); io.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });
        els.forEach(function (el) { io.observe(el); });
        // Safety net: never leave content hidden.
        setTimeout(showAll, 3000);
      })();
    </script>

    {/* Real Liquid-Glass refraction lens on the homepage chrome (Chromium gets
        true feDisplacementMap refraction; Safari/Firefox get a clean blur). */}
    <script>
      import { initLiquidGlass } from '../scripts/liquid-glass.js';
      if (document.body.classList.contains('theme-glass')) {
        const lens = (sel, opts) =>
          document.querySelectorAll(sel).forEach((el) => initLiquidGlass(el, opts));
        lens('.langswitch', { radius: 'max', scale: 18, chroma: 3, tint: 0.32, specular: 0.55, backdropBlur: 1 });
        lens('.ilink--cv', { radius: 'max', scale: 9, chroma: 2, tint: 0.66, saturation: 1.25, specular: 0.5, backdropBlur: 2, press: true, pressFactor: 2.4 });
        lens('.status', { radius: 'max', scale: 12, chroma: 2, tint: 0.4, specular: 0.5, backdropBlur: 2 });
      }
    </script>
  </body>
</html>
