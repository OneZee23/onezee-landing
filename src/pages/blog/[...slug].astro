---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LikeButton from '../../components/LikeButton.tsx';
import ViewCounter from '../../components/ViewCounter.tsx';
import { Icon } from '../../components/Icon';
import { AUTHOR } from '../../consts';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, updated, excerpt, cover, tags, telegramUrl, series, day, total, lang } = post.data;

const hasProgress = day != null && total != null;
const progressPct = hasProgress ? Math.min(100, Math.round((day / total) * 100)) : 0;

const isoDate = date.toISOString();
const isoModified = (updated ?? date).toISOString();
const locale = lang === 'ru' ? 'ru-RU' : 'en-US';
const fmtDate = (d: Date) =>
  d.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });

// Reading time from the raw markdown (~150 wpm; Russian words run longer).
const words = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.ceil(words / 150));

const t =
  lang === 'ru'
    ? { back: '← ко всем постам', read: `${readMin} мин`, tg: 'Читать в Telegram', newer: 'Новее', older: 'Старше' }
    : { back: '← all posts', read: `${readMin} min read`, tg: 'Read on Telegram', newer: 'Newer', older: 'Older' };

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString();
const blogUrl = new URL('/blog', Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      datePublished: isoDate,
      dateModified: isoModified,
      inLanguage: locale,
      author: { '@type': 'Person', name: AUTHOR, url: siteUrl },
      publisher: { '@type': 'Person', name: AUTHOR },
      mainEntityOfPage: pageUrl,
      url: pageUrl,
      timeRequired: `PT${readMin}M`,
      ...(cover ? { image: new URL(cover, Astro.site).toString() } : {}),
      ...(tags.length ? { keywords: tags.join(', ') } : {}),
      ...(series ? { articleSection: series } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'onezee.dev', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
        { '@type': 'ListItem', position: 3, name: title },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${title} — ${AUTHOR}`}
  description={excerpt || title}
  type="article"
  theme="glass"
  reading
  image={cover}
  publishedTime={date}
  modifiedTime={updated ?? date}
  tags={tags}
  lang={lang}
>
  <article class="post" lang={lang}>
    <a class="bloghead__back" href="/blog">{t.back}</a>
    <div class="post__meta">
      {series && <span class="series-badge">{series}</span>}
      <time class="post__date" datetime={isoDate}>{fmtDate(date)}</time>
      <span class="post__readtime">· {t.read}</span>
      <ViewCounter postId={post.id} lang={lang} client:idle />
      <span class="lang-tag">{lang}</span>
    </div>
    <h1 class="post__title">{title}</h1>
    {hasProgress && (
      <div class="pow" title={`Day ${day} of ${total}`}>
        <span class="pow__label">День {day}/{total}{day > total ? ' · overtime' : ''}</span>
        <span class="pow__track"><span class="pow__fill" style={`width:${progressPct}%`}></span></span>
      </div>
    )}
    {cover && <img class="post__cover" src={cover} alt="" width="800" height="450" />}

    <div class="prose-article">
      <Content />
    </div>

    <footer class="post__footer">
      <LikeButton postId={post.id} client:visible />
      {telegramUrl && (
        <a class="post__tg" href={telegramUrl} target="_blank" rel="noreferrer noopener">
          <Icon name="telegram" size={15} />
          <span>{t.tg} →</span>
        </a>
      )}
    </footer>

    {(newer || older) && (
      <nav class="post__nav" aria-label="More posts">
        {older ? (
          <a href={`/blog/${older.id}`}>
            <span class="post__nav-dir">{t.older}</span>
            <span class="post__nav-title">{older.data.title}</span>
          </a>
        ) : <span></span>}
        {newer && (
          <a class="post__nav-next" href={`/blog/${newer.id}`}>
            <span class="post__nav-dir">{t.newer}</span>
            <span class="post__nav-title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
</BaseLayout>
