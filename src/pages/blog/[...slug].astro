---
import { getCollection, render } from 'astro:content';
import SteamLayout from '../../layouts/SteamLayout.astro';
import LikeButton from '../../components/LikeButton.tsx';
import ViewCounter from '../../components/ViewCounter.tsx';
import { Icon } from '../../components/Icon';
import { AUTHOR } from '../../consts';
import { seriesIcon, seriesSlug } from '../../consts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, updated, excerpt, cover, tags, telegramUrl, series, day, total, lang } = post.data;

const hasProgress = day != null && total != null;
const progressPct = hasProgress ? Math.min(100, Math.round((day / total) * 100)) : 0;

const isoDate = date.toISOString();
const isoModified = (updated ?? date).toISOString();
const locale = lang === 'ru' ? 'ru-RU' : 'en-US';
const fmtDate = (d: Date) =>
  d.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });

// Reading time from the raw markdown (~150 wpm; Russian words run longer).
const words = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.ceil(words / 150));

const t =
  lang === 'ru'
    ? { blog: 'Блог', read: `${readMin} мин чтения`, tg: 'Обсудить в Telegram', newer: 'Новее', older: 'Старше' }
    : { blog: 'Blog', read: `${readMin} min read`, tg: 'Discuss on Telegram', newer: 'Newer', older: 'Older' };
const icon = series ? seriesIcon(series) : null;
// Telegram posts open with their title as a bold first line; under the page
// heading that reads twice, so the first paragraph hides when it is the title.
const norm = (s: string) => s.replace(/[*_~`#>\s]/g, '').toLowerCase();
const firstLine = (post.body ?? '').trim().split('\n')[0] ?? '';
const repeatsTitle = norm(firstLine) === norm(title);

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString();
const blogUrl = new URL('/blog', Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      datePublished: isoDate,
      dateModified: isoModified,
      inLanguage: locale,
      author: { '@type': 'Person', name: AUTHOR, url: siteUrl },
      publisher: { '@type': 'Person', name: AUTHOR },
      mainEntityOfPage: pageUrl,
      url: pageUrl,
      timeRequired: `PT${readMin}M`,
      ...(cover ? { image: new URL(cover, Astro.site).toString() } : {}),
      ...(tags.length ? { keywords: tags.join(', ') } : {}),
      ...(series ? { articleSection: series } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'onezee.dev', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
        { '@type': 'ListItem', position: 3, name: title },
      ],
    },
  ],
};
---

<SteamLayout
  lang={lang}
  section="blog"
  title={`${title}. ${AUTHOR}`}
  description={excerpt || title}
  type="article"
  image={cover}
  publishedTime={date}
  modifiedTime={updated ?? date}
  tags={tags}
>
  <div class="bgband bgband--short">
    <main class="w blog">
      <p class="crumbs crumbs--top crumbs--post">
        <a href="/blog">{t.blog}</a>
        {series && <><i aria-hidden="true">›</i><a href={`/blog/series/${seriesSlug(series)}`}>{series}</a></>}
      </p>
      <article class="panel post" lang={lang}>
        <header class="post-head">
          {icon && <img src={icon} alt="" width="40" height="40" />}
          <div>
            <h1>{title}</h1>
            <p class="small post-meta">
              <time datetime={isoDate}>{fmtDate(date)}</time>
              <span>{t.read}</span>
              <ViewCounter postId={post.id} lang={lang} client:idle />
              <span class="lang-chip">{lang.toUpperCase()}</span>
            </p>
          </div>
        </header>
        {hasProgress && (
          <div class="pow" title={`Day ${day} of ${total}`}>
            <span class="small">День {day}/{total}{day > total ? ', сверх плана' : ''}</span>
            <span class="track"><i style={`width:${progressPct}%`}></i></span>
          </div>
        )}
        {cover && <img class="post-cover" src={cover} alt="" width="800" height="450" />}
        <div class:list={['prose', { 'skip-first': repeatsTitle }]}>
          <Content />
        </div>
        <footer class="post-foot">
          <LikeButton postId={post.id} client:visible />
          {telegramUrl && (
            <a class="btn dark" href={telegramUrl} target="_blank" rel="noreferrer noopener"><span>{t.tg}</span></a>
          )}
        </footer>
      </article>

      {(newer || older) && (
        <nav class="post-nav" aria-label={lang === 'ru' ? 'Другие посты' : 'More posts'}>
          {older ? (
            <a class="panel" href={`/blog/${older.id}`}>
              <span class="small">← {t.older}</span>
              <span class="post-nav-title">{older.data.title}</span>
            </a>
          ) : <span></span>}
          {newer && (
            <a class="panel post-nav-next" href={`/blog/${newer.id}`}>
              <span class="small">{t.newer} →</span>
              <span class="post-nav-title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </main>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
</SteamLayout>
