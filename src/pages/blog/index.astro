---
// Blog index as a Steam news hub: latest posts, then one collapsible group per
// project (series), ordered by recent activity. Posts come from the Telegram
// channel (#site) via scripts/ingest-telegram.mjs.
import { getCollection } from 'astro:content';
import SteamLayout from '../../layouts/SteamLayout.astro';
import PostRow from '../../steam/PostRow.astro';
import { ruPlural } from '../../steam/copy';
import { externalWriting, mentions } from '../../data';
import { TELEGRAM_CHANNEL_URL, seriesSlug, seriesIcon } from '../../consts';

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

type Post = (typeof all)[number];
const bySeries = new Map<string, Post[]>();
for (const p of all) {
  const key = p.data.series ?? '__notes__';
  (bySeries.get(key) ?? bySeries.set(key, []).get(key)!).push(p);
}
interface Group {
  title: string;
  slug: string | null; // project page slug (null for the "Заметки" bucket)
  icon: string | null;
  posts: Post[];
  latest: number;
}
const groups: Group[] = [];
for (const [key, posts] of bySeries) {
  if (key === '__notes__') continue;
  groups.push({ title: key, slug: seriesSlug(key), icon: seriesIcon(key), posts, latest: posts[0].data.date.valueOf() });
}
groups.sort((a, b) => b.latest - a.latest);
const notes = bySeries.get('__notes__');
if (notes?.length) groups.push({ title: 'Заметки', slug: null, icon: null, posts: notes, latest: 0 });
const count = (n: number) => `${n} ${ruPlural(n, 'пост', 'поста', 'постов')}`;
---

<SteamLayout
  lang="ru"
  section="blog"
  title="Блог. Никита Шевелев"
  description="Заметки о бэкенде, web3 и инди-разработке из моего Telegram-канала."
>
  <div class="bgband bgband--short">
    <main class="w blog">
      <div class="hub-head">
        <img src="/icons/onezee.png" alt="" width="64" height="64" />
        <div>
          <h1>Блог</h1>
          <p class="small">
            Заметки о бэкенде, web3 и инди-разработке. Посты с меткой #site из моего
            <a href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noreferrer noopener">Telegram-канала</a> попадают сюда сами.
          </p>
        </div>
      </div>

      {all.length > 0 && (
        <section>
          <div class="sh"><h2>Свежее</h2><span>{count(all.length)} всего</span></div>
          <ul class="panel newslist" role="list">
            {all.slice(0, 6).map((p) => <PostRow post={p} showSeries />)}
          </ul>
        </section>
      )}

      <section>
        <div class="sh"><h2>По проектам</h2></div>
        <div class="hubs">
          {groups.map((g) => (
            <details class="panel hub">
              <summary>
                <img src={g.icon ?? '/icons/onezee.png'} alt="" width="32" height="32" loading="lazy" />
                <span class="hub-name">{g.title}</span>
                <span class="small">{count(g.posts.length)}</span>
              </summary>
              <ul class="newslist" role="list">
                {(g.slug ? g.posts.slice(0, 5) : g.posts).map((p) => <PostRow post={p} />)}
              </ul>
              {g.slug && <a class="hub-all" href={`/blog/series/${g.slug}`}>Все посты {g.title} по порядку →</a>}
            </details>
          ))}
        </div>
      </section>

      {(externalWriting.length > 0 || mentions.length > 0) && (
        <section>
          <div class="sh"><h2>Где ещё пишу</h2></div>
          <div class="panel book book--wide">
            <ul class="facts">
              {externalWriting.map((w) => <li><a href={w.url} target="_blank" rel="noreferrer noopener">{w.label}</a></li>)}
              {mentions.map((m) => <li>{m.outlet}: <a href={m.url} target="_blank" rel="noreferrer noopener">{m.label}</a></li>)}
            </ul>
          </div>
        </section>
      )}
    </main>
  </div>
</SteamLayout>
