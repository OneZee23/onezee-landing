---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { Icon } from '../../components/Icon';
import { externalWriting, mentions } from '../../data';
import { TELEGRAM_CHANNEL_URL, seriesSlug, seriesIcon } from '../../consts';
import '../../styles/blog.css';

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Collapsible "chapters": each project (series) groups its posts (newest first);
// chapters are ordered by most-recent activity; ungrouped posts go to "Заметки".
type Post = (typeof all)[number];
const bySeries = new Map<string, Post[]>();
for (const p of all) {
  const key = p.data.series ?? '__notes__';
  (bySeries.get(key) ?? bySeries.set(key, []).get(key)!).push(p);
}

interface Group {
  title: string;
  slug: string | null; // topic-page slug (null for the "Заметки" bucket)
  icon: string | null;
  posts: Post[];
  latest: number;
}
const groups: Group[] = [];
for (const [key, posts] of bySeries) {
  if (key === '__notes__') continue;
  groups.push({ title: key, slug: seriesSlug(key), icon: seriesIcon(key), posts, latest: posts[0].data.date.valueOf() });
}
groups.sort((a, b) => b.latest - a.latest);
const notes = bySeries.get('__notes__');
if (notes?.length) groups.push({ title: 'Заметки', slug: null, icon: null, posts: notes, latest: 0 });
---

<BaseLayout
  lang="ru"
  theme="glass"
  reading
  title="Блог — Никита Шевелев"
  description="Заметки о бэкенде, web3 и инди-разработке — из моего Telegram-канала."
>
  <div class="blogwrap">
    <a class="bloghead__back" href="/">← onezee.dev</a>
    <p class="eyebrow">Дневник</p>
    <h1 class="blogtitle">Заметки из канала</h1>
    <p class="prose">
      О бэкенде, web3 и суровой реальности инди-разработки. Посты, помеченные
      <code>#site</code> в моём <a href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noreferrer noopener">Telegram-канале</a>, попадают сюда автоматически.
      Сгруппированы по проектам (можно свернуть); внутри — по дате. Каждый пост помечен <span class="lang-tag">RU</span> или <span class="lang-tag">EN</span>.
    </p>

    {all.length === 0 && (
      <p class="prose" style="margin-top:2rem;color:var(--faint)">Пока пусто — первый пост скоро будет.</p>
    )}

    {all.length > 0 && (
      <section class="blog-latest">
        <p class="eyebrow">Свежее</p>
        <ul class="postlist" role="list">
          {all.slice(0, 8).map((p) => <PostCard post={p} showSeries />)}
        </ul>
      </section>
    )}

    {groups.map((g) => (
      <details class="blog-season" open>
        <summary class="blog-season__head">
          {g.icon && <img class="blog-season__logo" src={g.icon} alt="" width="30" height="30" loading="lazy" />}
          <span class="blog-season__title">{g.title}</span>
          <span class="blog-season__count">{g.posts.length}</span>
        </summary>
        <div class="blog-season__body">
          {g.slug && (
            <a class="blog-season__all" href={`/blog/series/${g.slug}`}>Все посты {g.title} →</a>
          )}
          <ul class="postlist" role="list">
            {g.posts.map((p) => <PostCard post={p} />)}
          </ul>
        </div>
      </details>
    ))}

    {externalWriting.length > 0 && (
      <section class="blogsection">
        <p class="eyebrow">Где ещё пишу</p>
        <div class="linkrow">
          {externalWriting.map((w) => (
            <a class="ilink" href={w.url} target="_blank" rel="noreferrer noopener">
              <Icon name={w.kind} size={16} />
              <span>{w.label}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {mentions.length > 0 && (
      <section class="blogsection">
        <p class="eyebrow">Интервью и упоминания</p>
        <ul class="mentionlist" role="list">
          {mentions.map((m) => (
            <li>
              <span class="mentionlist__outlet">{m.outlet}</span>
              <br />
              <a class="ilink" href={m.url} target="_blank" rel="noreferrer noopener"><span>{m.label}</span></a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
