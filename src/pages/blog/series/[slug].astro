---
import { getCollection } from 'astro:content';
import SteamLayout from '../../../layouts/SteamLayout.astro';
import PostRow from '../../../steam/PostRow.astro';
import { ruPlural } from '../../../steam/copy';
import { seriesIcon, seriesSlug } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && !!data.series);
  // Key by SLUG (not raw name) so two series names that slugify the same don't
  // produce duplicate paths (which would break the build); their posts merge.
  const bySlug = new Map<string, { series: string; items: typeof posts }>();
  for (const p of posts) {
    const name = p.data.series as string;
    const slug = seriesSlug(name);
    const entry = bySlug.get(slug) ?? { series: name, items: [] };
    entry.items.push(p);
    bySlug.set(slug, entry);
  }
  return [...bySlug.entries()].map(([slug, { series, items }]) => ({
    params: { slug },
    // Oldest → newest: a project topic reads as the build story from day one.
    props: { series, posts: items.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf()) },
  }));
}

const { series, posts } = Astro.props;
const total = posts.find((p) => p.data.total != null)?.data.total;
const icon = seriesIcon(series);
---

<SteamLayout
  lang="ru"
  section="blog"
  title={`${series}, дневник проекта. Никита Шевелев`}
  description={`Все посты про ${series}: как проект строился с первого дня.`}
>
  <div class="bgband bgband--short">
    <main class="w blog">
      <p class="crumbs crumbs--top"><a href="/blog">Блог</a><i aria-hidden="true">›</i><span class="cur">{series}</span></p>
      <div class="hub-head">
        <img src={icon ?? '/icons/onezee.png'} alt="" width="64" height="64" />
        <div>
          <h1>{series}</h1>
          <p class="small">
            {posts.length} {ruPlural(posts.length, 'пост', 'поста', 'постов')}{total ? `, ${total}-дневный спринт` : ''}. От первого дня к последнему.
          </p>
        </div>
      </div>
      <ul class="panel newslist" role="list">
        {posts.map((p) => <PostRow post={p} />)}
      </ul>
    </main>
  </div>
</SteamLayout>
