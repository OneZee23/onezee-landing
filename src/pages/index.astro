---
// Homepage. The existing React landing is server-rendered to static HTML at
// build time (NO hydration) — content is always in the DOM, which is great for
// SEO. The scroll-reveal fade-in is handled by the framework-independent script
// in BaseLayout, not by React.
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../App';
---

<BaseLayout>
  <App />
</BaseLayout>
