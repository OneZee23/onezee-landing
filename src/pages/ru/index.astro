---
// Homepage (Russian) at /ru/.
import SteamLayout from '../../layouts/SteamLayout.astro';
import Profile from '../../steam/Profile.astro';
import { COPY } from '../../steam/copy';

const t = COPY.ru;
const alternates = [
  { hreflang: 'en', href: new URL('/', Astro.site).toString() },
  { hreflang: 'ru', href: new URL('/ru/', Astro.site).toString() },
  { hreflang: 'x-default', href: new URL('/', Astro.site).toString() },
];
---

<SteamLayout lang="ru" section="profile" title={t.title} description={t.description} alternates={alternates} switchTo={{ en: '/', ru: '/ru/' }}>
  <Profile lang="ru" />
</SteamLayout>
