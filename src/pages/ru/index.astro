---
// Homepage (Russian) at /ru/. Same React app rendered with lang="ru".
import BaseLayout from '../../layouts/BaseLayout.astro';
import App from '../../App';

const alternates = [
  { hreflang: 'en', href: new URL('/', Astro.site).toString() },
  { hreflang: 'ru', href: new URL('/ru/', Astro.site).toString() },
  { hreflang: 'x-default', href: new URL('/', Astro.site).toString() },
];
---

<BaseLayout
  lang="ru"
  theme="glass"
  title="Никита Шевелев — Senior Backend Engineer"
  description="Senior backend-инженер: NestJS, TypeScript, Node.js. Высоконагруженные системы, платежи и блокчейн. Делаю бэкенд крипто/финтех super-app и выпускаю свои приложения."
  alternates={alternates}
>
  <App lang="ru" />
</BaseLayout>
